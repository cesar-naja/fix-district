# Fix District browser-test (Playwright) environment template.
# Copy to e2e/.env.local (git-ignored) and fill in. Never commit real values.
# These variables are read only by the E2E runner (e2e/config/env.ts). They are
# deliberately separate from the repository root .env.local, which may hold
# live credentials.

# --- Dedicated Clerk application (DEVELOPMENT instance) ------------------------
# Create a NEW Clerk application just for tests (free development instance).
# Do not reuse the application your root .env.local points at: the runner
# refuses a publishable key identical to the one in that file.
# Clerk Dashboard > (test application) > API keys.
E2E_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
E2E_CLERK_SECRET_KEY=sk_test_replace_me
# Frontend API host of the test application, with no https://. Shown on the same
# API keys page. It must match the publishable key. Typing it is a deliberate
# confirmation that these keys belong to the dedicated test application.
E2E_CLERK_FRONTEND_API=replace-me.clerk.accounts.dev

# --- Optional (defaults shown) -----------------------------------------------
# E2E_PORT=3100                          # never 3000
# E2E_FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
# E2E_FIREBASE_PROJECT_ID=demo-fix-district-e2e
# E2E_WORKERS=1                          # 1 to 4
# E2E_SERVER_MODE=dev                    # dev locally, build on CI
# E2E_TRACE=retain-on-failure            # off on CI. Traces can contain cookies and
                                         # Clerk responses: keep them private.

# Leftover test users: the framework only deletes users it created in the same
# run, and tags each one (public metadata `e2e`). If a run crashes, remove the
# leftovers by hand in the test application's Dashboard > Users. Their emails
# look like e2e-<runid>-w0-customer-<hex>+clerk_test@example.com.
