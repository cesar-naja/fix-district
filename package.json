{
  "name": "fix-district",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "emulators": "firebase emulators:start --only firestore --project demo-fix-district",
    "test": "firebase emulators:exec --only firestore --project demo-fix-district \"vitest run\"",
    "emulators:e2e": "firebase emulators:start --config firebase.e2e.json --only firestore --project demo-fix-district-e2e",
    "test:e2e": "firebase emulators:exec --config firebase.e2e.json --only firestore --project demo-fix-district-e2e \"playwright test\"",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.21",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@clerk/backend": "^3.26.5",
    "@clerk/testing": "^2.2.53",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.34.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
