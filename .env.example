# Fix District environment template.
# Copy to .env.local (git-ignored) and fill in your own values.
# Never commit real values. Never prefix server secrets with NEXT_PUBLIC_.

# --- Clerk (authentication) -------------------------------------------------
# Clerk Dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Firebase Admin (server-only, repair data) --------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Copy the three values from the downloaded JSON file. Do NOT commit that file.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes. Keep the \n sequences exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# --- Local development against the Firestore emulator (optional) --------------
# Uncomment to run the app against `npm run emulators` instead of the live
# project. No credentials are needed in this mode. Leave unset otherwise, and
# never set it in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# --- Firebase web config (client SDK) ----------------------------------------
# Present for the existing lib/firebase.ts. Repair data does NOT use it: the
# browser never reads or writes Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=